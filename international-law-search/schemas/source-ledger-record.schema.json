{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/international-law-search/source-ledger-record.schema.json",
  "title": "International Law Search Lightweight Source Ledger Record",
  "description": "The shared, upgrade-safe source record used by quick and standard-interactive modes.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "source_key",
    "identity_evidence",
    "discovery_provenance",
    "availability",
    "review_extent",
    "description_basis",
    "description",
    "inclusion_reason",
    "user_decisions"
  ],
  "properties": {
    "source_key": {
      "description": "A stable project-local key preserved during mode upgrades.",
      "type": "string",
      "minLength": 1
    },
    "identity_evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["normalized_title", "identity_status", "evidence"],
      "properties": {
        "normalized_title": {"type": "string", "minLength": 1},
        "creators": {
          "type": "array",
          "items": {"type": "string", "minLength": 1}
        },
        "publication_date": {"type": ["string", "null"]},
        "publication": {"type": ["string", "null"]},
        "raw_citation": {"type": ["string", "null"]},
        "identity_status": {"enum": ["verified", "candidate", "conflict"]},
        "evidence": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["kind", "value"],
            "properties": {
              "kind": {
                "enum": [
                  "official_record",
                  "publisher_record",
                  "database_record",
                  "document_text",
                  "user_supplied_public_citation",
                  "other"
                ]
              },
              "value": {"type": "string", "minLength": 1},
              "locator": {"type": ["string", "null"]},
              "checked_at": {"type": ["string", "null"]}
            }
          }
        }
      }
    },
    "identifiers": {
      "type": "object",
      "properties": {
        "doi": {"type": "string", "minLength": 1},
        "isbn": {"type": "string", "minLength": 1},
        "isbn_10": {"type": "string", "minLength": 1},
        "isbn_13": {"type": "string", "minLength": 1},
        "oclc": {"type": "string", "minLength": 1},
        "lccn": {"type": "string", "minLength": 1},
        "worldcat": {"type": "string", "minLength": 1},
        "official_document_number": {"type": "string", "minLength": 1},
        "document_number": {"type": "string", "minLength": 1},
        "case_number": {"type": "string", "minLength": 1},
        "treaty_number": {"type": "string", "minLength": 1},
        "treaty_identifier": {"type": "string", "minLength": 1},
        "publisher_id": {"type": "string", "minLength": 1},
        "stable_publisher_id": {"type": "string", "minLength": 1}
      },
      "additionalProperties": {"type": "string", "minLength": 1}
    },
    "source_key_aliases": {
      "type": "array",
      "items": {"type": "string", "minLength": 1},
      "uniqueItems": true
    },
    "citation_aliases": {
      "type": "array",
      "items": {"type": "string", "minLength": 1},
      "uniqueItems": true
    },
    "metadata_conflicts": {
      "type": "object",
      "additionalProperties": {
        "type": "array",
        "minItems": 2,
        "items": {
          "type": "object",
          "additionalProperties": false,
          "required": ["value", "source_key"],
          "properties": {
            "value": {},
            "source_key": {"type": "string", "minLength": 1}
          }
        }
      }
    },
    "links": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["kind", "url"],
        "properties": {
          "kind": {
            "enum": ["official", "publisher", "open_access", "database", "other"]
          },
          "url": {"type": "string", "minLength": 1}
        }
      }
    },
    "local_paths": {
      "type": "array",
      "items": {"type": "string", "minLength": 1},
      "uniqueItems": true
    },
    "source_type": {"type": ["string", "null"], "minLength": 1},
    "source_details": {
      "oneOf": [
        {"$ref": "#/$defs/case_details"},
        {"$ref": "#/$defs/treaty_details"},
        {"$ref": "#/$defs/international_organization_document_details"},
        {"$ref": "#/$defs/article_details"},
        {"$ref": "#/$defs/book_details"},
        {"$ref": "#/$defs/chapter_details"},
        {"$ref": "#/$defs/working_paper_details"},
        {"$ref": "#/$defs/institutional_report_details"},
        {"$ref": "#/$defs/commentary_details"}
      ]
    },
    "legal_status_context": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "source_category": {"type": "string", "minLength": 1},
        "issuing_authority": {"type": ["string", "null"]},
        "addressees_or_parties": {"$ref": "#/$defs/string_array"},
        "procedural_posture": {"type": ["string", "null"]},
        "jurisdictional_context": {"type": ["string", "null"]},
        "status_date": {"type": ["string", "null"]}
      }
    },
    "language": {"type": ["string", "null"], "minLength": 2},
    "discovery_provenance": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["method", "value"],
        "properties": {
          "method": {
            "enum": [
              "query",
              "platform",
              "source",
              "footnote",
              "reference",
              "cited_by",
              "subagent",
              "local_seed"
            ]
          },
          "value": {"type": "string", "minLength": 1},
          "platform": {"type": ["string", "null"]},
          "branch_id": {"type": ["string", "null"]},
          "parent_source_key": {"type": ["string", "null"]},
          "locator": {"type": ["string", "null"]},
          "discovered_at": {"type": ["string", "null"]},
          "privacy_classification": {
            "enum": ["public_citation_extract", "private_note_reference"]
          },
          "externalizable": {"type": "boolean"}
        },
        "allOf": [
          {
            "if": {"properties": {"method": {"const": "local_seed"}}},
            "then": {"required": ["privacy_classification", "externalizable"]}
          },
          {
            "if": {
              "required": ["privacy_classification"],
              "properties": {
                "privacy_classification": {"const": "private_note_reference"}
              }
            },
            "then": {
              "required": ["externalizable"],
              "properties": {"externalizable": {"const": false}}
            }
          }
        ]
      }
    },
    "availability": {
      "enum": [
        "open_full_text",
        "subscription_full_text",
        "identified_inaccessible",
        "abstract_available",
        "metadata_only",
        "access_failure"
      ]
    },
    "review_extent": {
      "enum": [
        "full_text_substantively_reviewed",
        "selected_sections_reviewed",
        "abstract_reviewed",
        "metadata_verified",
        "not_reviewed"
      ]
    },
    "description_basis": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "locations"],
      "properties": {
        "kind": {
          "enum": ["full_text", "selected_sections", "abstract", "metadata", "none"]
        },
        "locations": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string", "minLength": 1},
          "uniqueItems": true
        }
      }
    },
    "description": {"type": "string", "minLength": 1},
    "inclusion_reason": {"type": "string", "minLength": 1},
    "ranking_factors": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "direct_relevance": {"$ref": "#/$defs/factor"},
        "legal_or_institutional_authority": {"$ref": "#/$defs/factor"},
        "scholarly_influence": {"$ref": "#/$defs/factor"},
        "citation_network_position": {"$ref": "#/$defs/factor"},
        "unique_viewpoint": {"$ref": "#/$defs/factor"},
        "recency": {"$ref": "#/$defs/factor"},
        "regional_or_linguistic_representation": {"$ref": "#/$defs/factor"},
        "verification_strength": {"$ref": "#/$defs/factor"},
        "introductory_value": {"$ref": "#/$defs/factor"},
        "research_issue_utility": {
          "type": "array",
          "items": {"type": "string", "minLength": 1},
          "uniqueItems": true
        }
      }
    },
    "reading_priority": {
      "enum": [
        "priority_reading",
        "read_by_research_direction",
        "background_or_supplementary"
      ]
    },
    "scholarly_importance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["level", "reason"],
      "properties": {
        "level": {
          "enum": ["foundational", "major", "useful", "peripheral", "not_assessed"]
        },
        "reason": {"type": "string", "minLength": 1}
      }
    },
    "acquisition_priority": {
      "enum": ["must_obtain", "should_obtain", "optional", "not_assessed"]
    },
    "acquisition_routes": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["route_type", "status"],
        "properties": {
          "route_type": {
            "enum": [
              "open",
              "subscription",
              "publisher",
              "library_holding",
              "physical_copy",
              "purchase",
              "document_delivery",
              "unavailable"
            ]
          },
          "status": {
            "enum": ["identified", "available", "requested", "acquired", "unavailable", "failed"]
          },
          "url": {"type": ["string", "null"], "minLength": 1},
          "institution": {"type": ["string", "null"], "minLength": 1},
          "identifier": {"type": ["string", "null"], "minLength": 1},
          "local_path": {"type": ["string", "null"], "minLength": 1},
          "externalizable": {"type": "boolean"},
          "checked_at": {"type": ["string", "null"], "minLength": 1},
          "note": {"type": ["string", "null"], "minLength": 1}
        },
        "allOf": [
          {
            "if": {
              "required": ["local_path"],
              "properties": {"local_path": {"type": "string", "minLength": 1}}
            },
            "then": {
              "required": ["externalizable"],
              "properties": {"externalizable": {"const": false}}
            }
          }
        ]
      }
    },
    "round_membership": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["round_id", "functions"],
        "properties": {
          "round_id": {"type": "string", "minLength": 1},
          "functions": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "enum": ["discovered", "acquired", "reviewed", "seed", "evidence", "background"]
            }
          }
        }
      }
    },
    "version_relationships": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["relation", "target"],
        "properties": {
          "relation": {
            "enum": [
              "version_of",
              "revises",
              "consolidates",
              "corrects",
              "has_protocol",
              "has_annex",
              "interprets_decision",
              "implements",
              "translated_as",
              "supersedes",
              "other"
            ]
          },
          "target": {"type": "string", "minLength": 1},
          "evidence": {"type": ["string", "null"]}
        }
      }
    },
    "user_decisions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["decision", "decided_at"],
        "properties": {
          "decision": {
            "enum": [
              "include",
              "exclude",
              "select_seed",
              "review_without_tracing",
              "trace",
              "hold",
              "stop_tracing",
              "prioritize_full_text"
            ]
          },
          "decided_at": {"type": "string", "minLength": 1},
          "round_id": {"type": ["string", "null"]},
          "note": {"type": ["string", "null"]}
        }
      }
    },
    "retrieval_history": {
      "description": "Optional deep-audit enrichment; quick and standard records do not require it.",
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["event_id", "platform", "retrieved_at"],
        "properties": {
          "event_id": {"type": "string", "minLength": 1},
          "platform": {"type": "string", "minLength": 1},
          "retrieved_at": {"type": "string", "minLength": 1},
          "result": {"type": ["string", "null"]},
          "link": {"type": ["string", "null"]},
          "local_path": {"type": ["string", "null"]}
        }
      }
    }
  },
  "$defs": {
    "factor": {
      "enum": ["high", "medium", "low", "unknown", "not_assessed"]
    },
    "string_array": {
      "type": "array",
      "items": {"type": "string", "minLength": 1},
      "uniqueItems": true
    },
    "case_details": {
      "type": "object",
      "additionalProperties": false,
      "required": ["court", "decision_date", "procedural_stage"],
      "properties": {
        "court": {"type": "string", "minLength": 1},
        "decision_date": {"type": "string", "minLength": 1},
        "procedural_stage": {"type": "string", "minLength": 1},
        "case_number": {"type": ["string", "null"]},
        "parties": {"$ref": "#/$defs/string_array"},
        "jurisdictional_context": {"type": ["string", "null"]},
        "relevant_paragraphs": {"$ref": "#/$defs/string_array"}
      }
    },
    "treaty_details": {
      "type": "object",
      "additionalProperties": false,
      "required": ["adoption_date", "status_date"],
      "properties": {
        "adoption_date": {"type": "string", "minLength": 1},
        "signature_date": {"type": ["string", "null"]},
        "entry_into_force_date": {"type": ["string", "null"]},
        "status_date": {"type": "string", "minLength": 1},
        "depositary": {"type": ["string", "null"]},
        "parties_or_applicability": {"$ref": "#/$defs/string_array"}
      }
    },
    "international_organization_document_details": {
      "type": "object",
      "additionalProperties": false,
      "required": ["organization", "organ", "document_number"],
      "properties": {
        "organization": {"type": "string", "minLength": 1},
        "organ": {"type": "string", "minLength": 1},
        "document_number": {"type": "string", "minLength": 1},
        "session": {"type": ["string", "null"]},
        "version": {"type": ["string", "null"]},
        "addressees": {"$ref": "#/$defs/string_array"},
        "status_date": {"type": ["string", "null"]}
      }
    },
    "article_details": {
      "type": "object",
      "additionalProperties": false,
      "required": ["journal"],
      "properties": {
        "journal": {"type": "string", "minLength": 1},
        "volume": {"type": ["string", "null"]},
        "issue": {"type": ["string", "null"]},
        "pages": {"type": ["string", "null"]}
      }
    },
    "book_details": {
      "type": "object",
      "additionalProperties": false,
      "required": ["publisher"],
      "properties": {
        "publisher": {"type": "string", "minLength": 1},
        "edition": {"type": ["string", "null"]},
        "place": {"type": ["string", "null"]}
      }
    },
    "chapter_details": {
      "type": "object",
      "additionalProperties": false,
      "required": ["book_title", "publisher"],
      "properties": {
        "book_title": {"type": "string", "minLength": 1},
        "publisher": {"type": "string", "minLength": 1},
        "editors": {"$ref": "#/$defs/string_array"},
        "edition": {"type": ["string", "null"]},
        "pages": {"type": ["string", "null"]}
      }
    },
    "working_paper_details": {
      "type": "object",
      "additionalProperties": false,
      "required": ["series_or_institution"],
      "properties": {
        "series_or_institution": {"type": "string", "minLength": 1},
        "number": {"type": ["string", "null"]},
        "version_date": {"type": ["string", "null"]}
      }
    },
    "institutional_report_details": {
      "type": "object",
      "additionalProperties": false,
      "required": ["issuing_institution"],
      "properties": {
        "issuing_institution": {"type": "string", "minLength": 1},
        "report_number": {"type": ["string", "null"]},
        "status_date": {"type": ["string", "null"]}
      }
    },
    "commentary_details": {
      "type": "object",
      "additionalProperties": false,
      "required": ["outlet"],
      "properties": {
        "outlet": {"type": "string", "minLength": 1},
        "editorial_or_practitioner_context": {"type": ["string", "null"]},
        "publication_date": {"type": ["string", "null"]}
      }
    }
  }
}
