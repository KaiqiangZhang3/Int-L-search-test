{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/international-law-search/source-record.schema.json",
  "title": "International Law Search Source Record",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "external_ids",
    "title",
    "creators",
    "date",
    "publication",
    "source_type",
    "fields",
    "subquestions",
    "authority_class",
    "collection_tier",
    "relevance",
    "availability",
    "review_extent",
    "stable_url",
    "local_path",
    "retrieval_history",
    "language",
    "description",
    "inclusion_reason",
    "description_basis",
    "description_retrieval_id",
    "discovery_history",
    "verification"
  ],
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1
    },
    "legacy_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "migration_review_required": {
      "type": "boolean"
    },
    "external_ids": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "aliases": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "creators": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "date": {
      "type": [
        "string",
        "null"
      ]
    },
    "publication": {
      "type": [
        "string",
        "null"
      ]
    },
    "source_type": {
      "type": "string",
      "minLength": 1
    },
    "source_details": {
      "oneOf": [
        {"$ref": "#/$defs/case_details"},
        {"$ref": "#/$defs/treaty_details"},
        {"$ref": "#/$defs/international_organization_document_details"},
        {"$ref": "#/$defs/article_details"},
        {"$ref": "#/$defs/book_details"},
        {"$ref": "#/$defs/chapter_details"},
        {"$ref": "#/$defs/working_paper_details"},
        {"$ref": "#/$defs/institutional_report_details"},
        {"$ref": "#/$defs/commentary_details"}
      ]
    },
    "legal_status_context": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "source_category": {"type": "string", "minLength": 1},
        "issuing_authority": {"type": ["string", "null"]},
        "addressees_or_parties": {"$ref": "#/$defs/string_array"},
        "procedural_posture": {"type": ["string", "null"]},
        "jurisdictional_context": {"type": ["string", "null"]},
        "status_date": {"type": ["string", "null"]}
      }
    },
    "links": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["kind", "url"],
        "properties": {
          "kind": {"enum": ["official", "publisher", "open_access", "database", "other"]},
          "url": {"type": "string", "minLength": 1}
        }
      }
    },
    "version_relationships": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["relation", "target"],
        "properties": {
          "relation": {
            "enum": [
              "version_of", "revises", "consolidates", "corrects",
              "has_protocol", "has_annex", "interprets_decision",
              "implements", "supersedes", "translated_as", "other"
            ]
          },
          "target": {"type": "string", "minLength": 1},
          "evidence": {"type": ["string", "null"]}
        }
      }
    },
    "fields": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "subquestions": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "authority_class": {
      "enum": [
        "primary",
        "authoritative_secondary",
        "general_academic",
        "gray_literature",
        "discovery_only"
      ]
    },
    "collection_tier": {
      "enum": [
        "core/canonical",
        "supplementary/emerging"
      ]
    },
    "relevance": {
      "enum": [
        "high",
        "medium",
        "low"
      ]
    },
    "availability": {
      "enum": [
        "open_full_text",
        "subscription_full_text",
        "identified_inaccessible",
        "abstract_available",
        "metadata_only",
        "access_failure"
      ]
    },
    "review_extent": {
      "enum": [
        "full_text_substantively_reviewed",
        "selected_sections_reviewed",
        "abstract_reviewed",
        "metadata_verified",
        "not_reviewed"
      ]
    },
    "stable_url": {
      "type": [
        "string",
        "null"
      ]
    },
    "local_path": {
      "type": [
        "string",
        "null"
      ]
    },
    "retrieval_history": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "event_id",
          "platform",
          "retrieved_at",
          "availability",
          "review_extent",
          "stable_url",
          "local_path"
        ],
        "properties": {
          "event_id": {
            "type": "string",
            "minLength": 1
          },
          "platform": {
            "type": "string",
            "minLength": 1
          },
          "retrieved_at": {
            "type": "string"
          },
          "availability": {
            "enum": [
              "open_full_text",
              "subscription_full_text",
              "identified_inaccessible",
              "abstract_available",
              "metadata_only",
              "access_failure"
            ]
          },
          "review_extent": {
            "enum": [
              "full_text_substantively_reviewed",
              "selected_sections_reviewed",
              "abstract_reviewed",
              "metadata_verified",
              "not_reviewed"
            ]
          },
          "stable_url": {
            "type": [
              "string",
              "null"
            ]
          },
          "local_path": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "allOf": [
          {
            "if": {"properties": {"availability": {"const": "access_failure"}}},
            "then": {"properties": {"review_extent": {"enum": ["not_reviewed"]}}}
          },
          {
            "if": {"properties": {"availability": {"const": "metadata_only"}}},
            "then": {"properties": {"review_extent": {"enum": ["metadata_verified", "not_reviewed"]}}}
          },
          {
            "if": {"properties": {"availability": {"enum": ["abstract_available", "identified_inaccessible"]}}},
            "then": {"properties": {"review_extent": {"enum": ["abstract_reviewed", "metadata_verified", "not_reviewed"]}}}
          }
        ]
      }
    },
    "language": {
      "type": "string",
      "minLength": 2
    },
    "description": {
      "type": "string",
      "minLength": 1
    },
    "inclusion_reason": {
      "type": "string",
      "minLength": 1
    },
    "description_basis": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "locations"
      ],
      "properties": {
        "kind": {
          "enum": [
            "full_text",
            "selected_sections",
            "abstract",
            "metadata"
          ]
        },
        "locations": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        }
      }
    },
    "description_retrieval_id": {
      "type": "string",
      "minLength": 1
    },
    "discovery_history": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "method",
          "value"
        ],
        "properties": {
          "method": {
            "enum": [
              "query",
              "source",
              "footnote",
              "reference",
              "subagent",
              "local_seed"
            ]
          },
          "value": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "verification": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "identity",
        "metadata_cross_checked",
        "human_review_required"
      ],
      "properties": {
        "identity": {
          "enum": [
            "verified",
            "candidate",
            "conflict"
          ]
        },
        "metadata_cross_checked": {
          "type": "boolean"
        },
        "human_review_required": {
          "type": "boolean"
        },
        "notes": {
          "type": "string"
        }
      }
    },
    "merge_conflicts": {
      "type": "object",
      "additionalProperties": {
        "type": "array",
        "minItems": 2,
        "items": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "value",
            "source_record_id"
          ],
          "properties": {
            "value": {},
            "source_record_id": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    }
  },
  "$defs": {
    "case_details": {
      "type": "object",
      "additionalProperties": false,
      "required": ["court", "decision_date", "procedural_stage"],
      "properties": {
        "court": {"type": "string", "minLength": 1},
        "decision_date": {"type": "string", "minLength": 1},
        "procedural_stage": {"type": "string", "minLength": 1},
        "case_number": {"type": ["string", "null"]},
        "parties": {"$ref": "#/$defs/string_array"},
        "jurisdictional_context": {"type": ["string", "null"]},
        "relevant_paragraphs": {"$ref": "#/$defs/string_array"}
      }
    },
    "treaty_details": {
      "type": "object",
      "additionalProperties": false,
      "required": ["adoption_date", "status_date"],
      "properties": {
        "adoption_date": {"type": "string", "minLength": 1},
        "signature_date": {"type": ["string", "null"]},
        "entry_into_force_date": {"type": ["string", "null"]},
        "status_date": {"type": "string", "minLength": 1},
        "depositary": {"type": ["string", "null"]},
        "parties_or_applicability": {"$ref": "#/$defs/string_array"}
      }
    },
    "international_organization_document_details": {
      "type": "object",
      "additionalProperties": false,
      "required": ["organization", "organ", "document_number"],
      "properties": {
        "organization": {"type": "string", "minLength": 1},
        "organ": {"type": "string", "minLength": 1},
        "document_number": {"type": "string", "minLength": 1},
        "session": {"type": ["string", "null"]},
        "version": {"type": ["string", "null"]},
        "addressees": {"$ref": "#/$defs/string_array"},
        "status_date": {"type": ["string", "null"]}
      }
    },
    "article_details": {
      "type": "object",
      "additionalProperties": false,
      "required": ["journal"],
      "properties": {
        "journal": {"type": "string", "minLength": 1},
        "volume": {"type": ["string", "null"]},
        "issue": {"type": ["string", "null"]},
        "pages": {"type": ["string", "null"]}
      }
    },
    "book_details": {
      "type": "object",
      "additionalProperties": false,
      "required": ["publisher"],
      "properties": {
        "publisher": {"type": "string", "minLength": 1},
        "edition": {"type": ["string", "null"]},
        "place": {"type": ["string", "null"]}
      }
    },
    "chapter_details": {
      "type": "object",
      "additionalProperties": false,
      "required": ["book_title", "publisher"],
      "properties": {
        "book_title": {"type": "string", "minLength": 1},
        "publisher": {"type": "string", "minLength": 1},
        "editors": {"$ref": "#/$defs/string_array"},
        "edition": {"type": ["string", "null"]},
        "pages": {"type": ["string", "null"]}
      }
    },
    "working_paper_details": {
      "type": "object",
      "additionalProperties": false,
      "required": ["series_or_institution"],
      "properties": {
        "series_or_institution": {"type": "string", "minLength": 1},
        "number": {"type": ["string", "null"]},
        "version_date": {"type": ["string", "null"]}
      }
    },
    "institutional_report_details": {
      "type": "object",
      "additionalProperties": false,
      "required": ["issuing_institution"],
      "properties": {
        "issuing_institution": {"type": "string", "minLength": 1},
        "report_number": {"type": ["string", "null"]},
        "status_date": {"type": ["string", "null"]}
      }
    },
    "commentary_details": {
      "type": "object",
      "additionalProperties": false,
      "required": ["outlet"],
      "properties": {
        "outlet": {"type": "string", "minLength": 1},
        "editorial_or_practitioner_context": {"type": ["string", "null"]},
        "publication_date": {"type": ["string", "null"]}
      }
    },
    "string_array": {
      "type": "array",
      "items": {"type": "string", "minLength": 1},
      "uniqueItems": true
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "description_basis": {
            "properties": {
              "kind": {
                "const": "full_text"
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "review_extent": {
            "enum": [
              "full_text_substantively_reviewed"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "description_basis": {
            "properties": {
              "kind": {
                "const": "selected_sections"
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "review_extent": {
            "enum": [
              "full_text_substantively_reviewed",
              "selected_sections_reviewed"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "description_basis": {
            "properties": {
              "kind": {
                "const": "abstract"
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "review_extent": {
            "enum": [
              "full_text_substantively_reviewed",
              "selected_sections_reviewed",
              "abstract_reviewed"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "description_basis": {
            "properties": {
              "kind": {
                "const": "metadata"
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "review_extent": {
            "enum": [
              "full_text_substantively_reviewed",
              "selected_sections_reviewed",
              "abstract_reviewed",
              "metadata_verified"
            ]
          }
        }
      }
    }
  ]
}
