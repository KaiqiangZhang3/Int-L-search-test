{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/international-law-search/edge-record.schema.json",
  "title": "International Law Search Edge Record",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "source_id",
    "target_id",
    "record_scope",
    "relation_family",
    "relation",
    "status"
  ],
  "properties": {
    "source_id": {
      "type": "string",
      "minLength": 1
    },
    "target_id": {
      "type": "string",
      "minLength": 1
    },
    "record_scope": {
      "enum": [
        "candidate",
        "canonical"
      ]
    },
    "relation_family": {
      "enum": [
        "literature",
        "institutional"
      ]
    },
    "relation": {
      "enum": [
        "cites",
        "cited_by",
        "responds_to",
        "criticizes",
        "extends",
        "amends",
        "implements",
        "interprets",
        "same_proceeding"
      ]
    },
    "status": {
      "enum": [
        "verified",
        "candidate"
      ]
    },
    "evidence": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": false,
      "required": [
        "source",
        "location"
      ],
      "properties": {
        "source": {
          "type": "string",
          "minLength": 1
        },
        "location": {
          "type": "string",
          "minLength": 1
        },
        "quoted_text": {
          "type": "string"
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "relation_family": {
            "const": "literature"
          }
        }
      },
      "then": {
        "properties": {
          "relation": {
            "enum": [
              "cites",
              "cited_by",
              "responds_to",
              "criticizes",
              "extends"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "relation_family": {
            "const": "institutional"
          }
        }
      },
      "then": {
        "properties": {
          "relation": {
            "enum": [
              "amends",
              "implements",
              "interprets",
              "same_proceeding"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "relation": {
            "enum": [
              "responds_to",
              "criticizes",
              "extends",
              "interprets"
            ]
          }
        }
      },
      "then": {
        "required": [
          "evidence"
        ],
        "properties": {
          "evidence": {
            "type": "object"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "verified"
          }
        }
      },
      "then": {
        "required": [
          "evidence"
        ],
        "properties": {
          "evidence": {
            "type": "object"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "candidate"
          }
        }
      },
      "then": {
        "properties": {
          "evidence": {
            "type": [
              "object",
              "null"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "record_scope": {
            "const": "canonical"
          }
        }
      },
      "then": {
        "properties": {
          "relation": {
            "enum": [
              "cites",
              "responds_to",
              "criticizes",
              "extends",
              "amends",
              "implements",
              "interprets",
              "same_proceeding"
            ]
          }
        }
      }
    }
  ]
}
