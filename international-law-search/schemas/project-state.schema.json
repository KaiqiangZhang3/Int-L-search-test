{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/international-law-search/project-state.schema.json",
  "title": "International Law Search Project State",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "graph_enabled",
    "saturation_enabled",
    "project_id",
    "created_at",
    "updated_at",
    "status",
    "current_checkpoint",
    "artifacts",
    "approved_plan",
    "decision_log",
    "branches",
    "coverage",
    "deduplication",
    "stopping"
  ],
  "properties": {
    "schema_version": {
      "const": 3
    },
    "graph_enabled": {
      "type": "boolean"
    },
    "saturation_enabled": {
      "type": "boolean"
    },
    "project_id": {
      "type": "string",
      "minLength": 1
    },
    "created_at": {
      "type": "string"
    },
    "updated_at": {
      "type": "string"
    },
    "status": {
      "enum": [
        "planning",
        "approved",
        "retrieving",
        "paused",
        "complete"
      ]
    },
    "current_checkpoint": {
      "type": ["string", "null"],
      "minLength": 1
    },
    "artifacts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sources",
        "claims",
        "rounds",
        "decisions",
        "terminology",
        "current_synthesis",
        "presentation_hub",
        "bibliography"
      ],
      "properties": {
        "sources": {"const": "knowledge/sources.jsonl"},
        "claims": {"const": "knowledge/claims.jsonl"},
        "rounds": {"const": "knowledge/rounds.jsonl"},
        "decisions": {"const": "knowledge/decisions.jsonl"},
        "terminology": {"const": "knowledge/terminology.jsonl"},
        "current_synthesis": {"type": ["string", "null"], "minLength": 1},
        "presentation_hub": {"type": ["string", "null"], "minLength": 1},
        "bibliography": {"const": "exports/bibliography.csv"}
      }
    },
    "approved_plan": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": false,
      "required": [
        "approved_by",
        "approved_at",
        "plan_path"
      ],
      "properties": {
        "approved_by": {
          "type": "string",
          "minLength": 1
        },
        "approved_at": {
          "type": "string"
        },
        "plan_path": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "decision_log": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "decision_id",
          "kind",
          "decided_by",
          "decided_at",
          "round_id"
        ],
        "properties": {
          "decision_id": {"type": "string", "minLength": 1},
          "kind": {
            "enum": [
              "select_seed",
              "approve_trace",
              "branch_delete",
              "budget_change",
              "pause",
              "resume",
              "close"
            ]
          },
          "decided_by": {"type": "string", "minLength": 1},
          "decided_at": {"type": "string", "minLength": 1},
          "round_id": {"type": "string", "minLength": 1},
          "branch_id": {"type": "string", "minLength": 1},
          "seed_id": {"type": "string", "minLength": 1},
          "directions": {
            "type": "array",
            "items": {"enum": ["backward", "forward", "lateral"]},
            "minItems": 1,
            "uniqueItems": true
          },
          "budget": {
            "$ref": "#/$defs/approvedBudget"
          }
        },
        "allOf": [
          {
            "if": {"properties": {"kind": {"const": "approve_trace"}}},
            "then": {
              "required": ["branch_id", "seed_id", "directions", "budget"]
            }
          }
        ]
      }
    },
    "branches": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "branch_id",
          "source_track",
          "retrieval_mode",
          "authorization_decision_id",
          "approved_budget",
          "vertical_seed_id",
          "tracing_direction",
          "known_id_snapshot",
          "status",
          "assignment",
          "scope",
          "exclusions",
          "source_types",
          "period",
          "privacy_constraints",
          "last_checkpoint",
          "platform_errors",
          "unresolved_items",
          "current_depth",
          "max_authorized_depth",
          "queries",
          "platforms",
          "languages",
          "pending_items",
          "open_paths",
          "status_reason",
          "status_changed_at"
        ],
        "properties": {
          "branch_id": {
            "type": "string",
            "minLength": 1
          },
          "source_track": {
            "enum": [
              "primary",
              "secondary",
              "mixed"
            ]
          },
          "retrieval_mode": {
            "enum": [
              "horizontal",
              "vertical"
            ]
          },
          "authorization_decision_id": {
            "type": ["string", "null"]
          },
          "approved_budget": {
            "oneOf": [
              {"$ref": "#/$defs/approvedBudget"},
              {"type": "null"}
            ]
          },
          "vertical_seed_id": {
            "type": [
              "string",
              "null"
            ]
          },
          "tracing_direction": {
            "enum": [
              "backward",
              "forward",
              "lateral",
              null
            ]
          },
          "known_id_snapshot": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "uniqueItems": true
          },
          "status": {
            "enum": [
              "pending",
              "active",
              "paused",
              "budget_paused",
              "complete",
              "failed"
            ]
          },
          "assignment": {
            "type": "string",
            "minLength": 1
          },
          "scope": {
            "type": "string",
            "minLength": 1
          },
          "exclusions": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "uniqueItems": true
          },
          "source_types": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "uniqueItems": true
          },
          "period": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "start",
              "end"
            ],
            "properties": {
              "start": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "end": {
                "type": [
                  "string",
                  "null"
                ]
              }
            }
          },
          "privacy_constraints": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "uniqueItems": true
          },
          "last_checkpoint": {
            "type": [
              "string",
              "null"
            ]
          },
          "platform_errors": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "platform",
                "error",
                "occurred_at"
              ],
              "properties": {
                "platform": {
                  "type": "string",
                  "minLength": 1
                },
                "error": {
                  "type": "string",
                  "minLength": 1
                },
                "occurred_at": {
                  "type": "string"
                }
              }
            }
          },
          "unresolved_items": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "uniqueItems": true
          },
          "current_depth": {
            "type": "integer",
            "minimum": 0
          },
          "max_authorized_depth": {
            "type": "integer",
            "minimum": 0
          },
          "queries": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "uniqueItems": true
          },
          "platforms": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "uniqueItems": true
          },
          "languages": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "uniqueItems": true
          },
          "pending_items": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "uniqueItems": true
          },
          "open_paths": {
            "type": "array",
            "items": {"type": "string"},
            "uniqueItems": true
          },
          "status_reason": {"type": ["string", "null"]},
          "status_changed_at": {"type": ["string", "null"]}
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "retrieval_mode": {
                  "const": "horizontal"
                }
              }
            },
            "then": {
              "properties": {
                "vertical_seed_id": {
                  "type": "null"
                },
                "authorization_decision_id": {
                  "type": "null"
                },
                "approved_budget": {
                  "type": "null"
                },
                "tracing_direction": {
                  "type": "null"
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "retrieval_mode": {
                  "const": "vertical"
                }
              }
            },
            "then": {
              "properties": {
                "vertical_seed_id": {
                  "type": "string",
                  "minLength": 1
                },
                "authorization_decision_id": {
                  "type": "string",
                  "minLength": 1
                },
                "approved_budget": {
                  "$ref": "#/$defs/approvedBudget"
                },
                "tracing_direction": {
                  "enum": [
                    "backward",
                    "forward",
                    "lateral"
                  ]
                }
              }
            }
          }
        ]
      }
    },
    "rounds": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "round_id",
          "timestamp",
          "budget_status",
          "decision",
          "decision_reason",
          "unresolved_gaps",
          "branch_depth",
          "attempted_queries_or_paths",
          "access_failures",
          "counts",
          "coverage_additions",
          "access_gaps",
          "open_high_value_branches"
        ],
        "properties": {
          "round_id": {
            "type": "string",
            "minLength": 1
          },
          "timestamp": {
            "type": "string"
          },
          "budget_status": {
            "enum": [
              "within_budget",
              "budget_paused"
            ]
          },
          "decision": {
            "enum": [
              "continue",
              "pause_for_user",
              "stop"
            ]
          },
          "decision_reason": {
            "type": "string",
            "minLength": 1
          },
          "unresolved_gaps": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "uniqueItems": true
          },
          "branch_depth": {
            "type": "object",
            "additionalProperties": {
              "type": "integer",
              "minimum": 0
            }
          },
          "attempted_queries_or_paths": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "access_failures": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "platform",
                "item",
                "error"
              ],
              "properties": {
                "platform": {
                  "type": "string",
                  "minLength": 1
                },
                "item": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "error": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          },
          "counts": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "candidate_count",
              "new_candidate_count",
              "new_high_relevance_count",
              "new_core_material_count",
              "duplicate_count",
              "duplicate_ratio"
            ],
            "properties": {
              "candidate_count": {
                "type": "integer",
                "minimum": 0
              },
              "new_candidate_count": {
                "type": "integer",
                "minimum": 0
              },
              "new_high_relevance_count": {
                "type": "integer",
                "minimum": 0
              },
              "new_core_material_count": {
                "type": "integer",
                "minimum": 0
              },
              "duplicate_count": {
                "type": "integer",
                "minimum": 0
              },
              "duplicate_ratio": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              }
            }
          },
          "coverage_additions": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "source_types",
              "themes",
              "languages",
              "platforms"
            ],
            "properties": {
              "source_types": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "uniqueItems": true
              },
              "themes": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "uniqueItems": true
              },
              "languages": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "uniqueItems": true
              },
              "platforms": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "uniqueItems": true
              }
            }
          },
          "access_gaps": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "uniqueItems": true
          },
          "open_high_value_branches": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "uniqueItems": true
          }
        }
      }
    },
    "coverage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "subquestions",
        "platforms",
        "languages",
        "periods",
        "authority_classes"
      ],
      "properties": {
        "subquestions": {
          "$ref": "#/$defs/coverageDimension"
        },
        "platforms": {
          "$ref": "#/$defs/coverageDimension"
        },
        "languages": {
          "$ref": "#/$defs/coverageDimension"
        },
        "periods": {
          "$ref": "#/$defs/coverageDimension"
        },
        "authority_classes": {
          "$ref": "#/$defs/coverageDimension"
        }
      }
    },
    "deduplication": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "identity_index",
        "unresolved_record_ids",
        "last_merged_at"
      ],
      "properties": {
        "identity_index": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "unresolved_record_ids": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "last_merged_at": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "stopping": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "decision",
        "reason",
        "open_high_value_branches"
      ],
      "properties": {
        "decision": {
          "enum": [
            "continue",
            "pause_for_user",
            "stop"
          ]
        },
        "reason": {
          "type": "string",
          "minLength": 1
        },
        "open_high_value_branches": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        }
      }
    }
  },
  "$defs": {
    "approvedBudget": {
      "type": "object",
      "additionalProperties": false,
      "minProperties": 1,
      "properties": {
        "source_cap": {"type": "integer", "minimum": 0},
        "full_text_review_cap": {"type": "integer", "minimum": 0},
        "depth_cap": {"type": "integer", "minimum": 0},
        "time_minutes": {"type": "integer", "minimum": 0}
      }
    },
    "coverageDimension": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "searched",
        "unsearched"
      ],
      "properties": {
        "searched": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "unsearched": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "const": "planning"
          }
        }
      },
      "then": {
        "properties": {
          "approved_plan": {
            "type": "null"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "enum": [
              "approved",
              "retrieving",
              "paused",
              "complete"
            ]
          }
        }
      },
      "then": {
        "properties": {
          "approved_plan": {
            "type": "object"
          }
        }
      }
    }
  ]
}
