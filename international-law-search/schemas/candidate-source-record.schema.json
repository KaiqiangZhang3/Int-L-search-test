{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/international-law-search/candidate-source-record.schema.json",
  "title": "International Law Search Candidate Source Record",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "candidate_id",
    "discovery_history",
    "availability",
    "review_extent",
    "description_basis",
    "description",
    "description_retrieval_id",
    "retrieval_history"
  ],
  "properties": {
    "candidate_id": {
      "type": "string",
      "minLength": 1
    },
    "title": {
      "type": [
        "string",
        "null"
      ]
    },
    "creators": {
      "type": [
        "array",
        "null"
      ],
      "items": {
        "type": "string"
      }
    },
    "external_ids": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": {
        "type": "string"
      }
    },
    "raw_citation_text": {
      "type": [
        "string",
        "null"
      ]
    },
    "source_type": {
      "type": [
        "string",
        "null"
      ]
    },
    "authority_class": {
      "type": [
        "string",
        "null"
      ],
      "enum": [
        "primary",
        "authoritative_secondary",
        "general_academic",
        "gray_literature",
        "discovery_only",
        null
      ]
    },
    "language": {
      "type": [
        "string",
        "null"
      ]
    },
    "relevance": {
      "type": [
        "string",
        "null"
      ],
      "enum": [
        "high",
        "medium",
        "low",
        null
      ]
    },
    "availability": {
      "enum": [
        "open_full_text",
        "subscription_full_text",
        "identified_inaccessible",
        "abstract_available",
        "metadata_only",
        "access_failure"
      ]
    },
    "review_extent": {
      "enum": [
        "full_text_substantively_reviewed",
        "selected_sections_reviewed",
        "abstract_reviewed",
        "metadata_verified",
        "not_reviewed"
      ]
    },
    "description_basis": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "locations"
      ],
      "properties": {
        "kind": {
          "enum": [
            "full_text",
            "selected_sections",
            "abstract",
            "metadata"
          ]
        },
        "locations": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        }
      }
    },
    "description": {
      "type": "string"
    },
    "description_retrieval_id": {
      "type": "string",
      "minLength": 1
    },
    "retrieval_history": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "event_id",
          "platform",
          "retrieved_at",
          "availability",
          "review_extent",
          "stable_url",
          "local_path"
        ],
        "properties": {
          "event_id": {
            "type": "string",
            "minLength": 1
          },
          "platform": {
            "type": "string",
            "minLength": 1
          },
          "retrieved_at": {
            "type": "string"
          },
          "availability": {
            "enum": [
              "open_full_text",
              "subscription_full_text",
              "identified_inaccessible",
              "abstract_available",
              "metadata_only",
              "access_failure"
            ]
          },
          "review_extent": {
            "enum": [
              "full_text_substantively_reviewed",
              "selected_sections_reviewed",
              "abstract_reviewed",
              "metadata_verified",
              "not_reviewed"
            ]
          },
          "stable_url": {
            "type": [
              "string",
              "null"
            ]
          },
          "local_path": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "allOf": [
          {
            "if": {"properties": {"availability": {"const": "access_failure"}}},
            "then": {"properties": {"review_extent": {"enum": ["not_reviewed"]}}}
          },
          {
            "if": {"properties": {"availability": {"const": "metadata_only"}}},
            "then": {"properties": {"review_extent": {"enum": ["metadata_verified", "not_reviewed"]}}}
          },
          {
            "if": {"properties": {"availability": {"enum": ["abstract_available", "identified_inaccessible"]}}},
            "then": {"properties": {"review_extent": {"enum": ["abstract_reviewed", "metadata_verified", "not_reviewed"]}}}
          }
        ]
      }
    },
    "discovery_history": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "method",
          "value"
        ],
        "properties": {
          "method": {
            "enum": [
              "query",
              "source",
              "footnote",
              "reference",
              "subagent",
              "local_seed"
            ]
          },
          "value": {
            "type": "string",
            "minLength": 1
          },
          "privacy_classification": {
            "enum": [
              "public_citation_extract",
              "private_note_reference"
            ]
          },
          "externalizable": {
            "type": "boolean"
          }
        },
        "allOf": [
          {
            "if": {"properties": {"method": {"const": "local_seed"}}},
            "then": {"required": ["privacy_classification", "externalizable"]}
          },
          {
            "if": {
              "required": ["privacy_classification"],
              "properties": {
                "privacy_classification": {"const": "private_note_reference"}
              }
            },
            "then": {
              "required": ["externalizable"],
              "properties": {"externalizable": {"const": false}}
            }
          }
        ]
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "description_basis": {
            "properties": {
              "kind": {
                "const": "full_text"
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "review_extent": {
            "enum": [
              "full_text_substantively_reviewed"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "description_basis": {
            "properties": {
              "kind": {
                "const": "selected_sections"
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "review_extent": {
            "enum": [
              "full_text_substantively_reviewed",
              "selected_sections_reviewed"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "description_basis": {
            "properties": {
              "kind": {
                "const": "abstract"
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "review_extent": {
            "enum": [
              "full_text_substantively_reviewed",
              "selected_sections_reviewed",
              "abstract_reviewed"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "description_basis": {
            "properties": {
              "kind": {
                "const": "metadata"
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "review_extent": {
            "enum": [
              "full_text_substantively_reviewed",
              "selected_sections_reviewed",
              "abstract_reviewed",
              "metadata_verified"
            ]
          }
        }
      }
    }
  ]
}
