{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/international-law-search/candidate-source-record.schema.json",
  "title": "International Law Search Candidate Source Record",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "candidate_id",
    "discovery_history",
    "access_status",
    "description_basis",
    "description",
    "description_retrieval_id",
    "retrieval_history"
  ],
  "properties": {
    "candidate_id": {
      "type": "string",
      "minLength": 1
    },
    "title": {
      "type": [
        "string",
        "null"
      ]
    },
    "creators": {
      "type": [
        "array",
        "null"
      ],
      "items": {
        "type": "string"
      }
    },
    "external_ids": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": {
        "type": "string"
      }
    },
    "raw_citation_text": {
      "type": [
        "string",
        "null"
      ]
    },
    "source_type": {
      "type": [
        "string",
        "null"
      ]
    },
    "authority_class": {
      "type": [
        "string",
        "null"
      ],
      "enum": [
        "primary",
        "authoritative_secondary",
        "general_academic",
        "gray_literature",
        "discovery_only",
        null
      ]
    },
    "language": {
      "type": [
        "string",
        "null"
      ]
    },
    "relevance": {
      "type": [
        "string",
        "null"
      ],
      "enum": [
        "high",
        "medium",
        "low",
        null
      ]
    },
    "access_status": {
      "enum": [
        "Full text read",
        "Abstract only",
        "Metadata only",
        "Full text not read",
        "Access failed"
      ]
    },
    "description_basis": {
      "enum": [
        "full_text",
        "abstract",
        "metadata"
      ]
    },
    "description": {
      "type": "string"
    },
    "description_retrieval_id": {
      "type": "string",
      "minLength": 1
    },
    "retrieval_history": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "event_id",
          "platform",
          "retrieved_at",
          "access_status",
          "stable_url",
          "local_path"
        ],
        "properties": {
          "event_id": {
            "type": "string",
            "minLength": 1
          },
          "platform": {
            "type": "string",
            "minLength": 1
          },
          "retrieved_at": {
            "type": "string"
          },
          "access_status": {
            "enum": [
              "Full text read",
              "Abstract only",
              "Metadata only",
              "Full text not read",
              "Access failed"
            ]
          },
          "stable_url": {
            "type": [
              "string",
              "null"
            ]
          },
          "local_path": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      }
    },
    "discovery_history": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "method",
          "value"
        ],
        "properties": {
          "method": {
            "enum": [
              "query",
              "source",
              "footnote",
              "reference",
              "subagent",
              "local_seed"
            ]
          },
          "value": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "description_basis": {
            "const": "full_text"
          }
        }
      },
      "then": {
        "properties": {
          "access_status": {
            "enum": [
              "Full text read"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "description_basis": {
            "const": "abstract"
          }
        }
      },
      "then": {
        "properties": {
          "access_status": {
            "enum": [
              "Abstract only",
              "Full text not read",
              "Full text read"
            ]
          }
        }
      }
    }
  ]
}
