{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/international-law-search/readiness-matrix.schema.json",
  "title": "International Law Search Readiness Matrix",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "project_id",
    "updated_at",
    "selected_scale",
    "topics",
    "next_round_designable",
    "remaining_material_questions"
  ],
  "properties": {
    "project_id": {
      "type": "string",
      "minLength": 1
    },
    "updated_at": {
      "type": "string",
      "minLength": 1
    },
    "selected_scale": {
      "enum": [
        "orientation",
        "seminar_paper",
        "thesis_chapter",
        "doctoral_corpus",
        "custom",
        null
      ]
    },
    "topics": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["topic", "status", "value", "evidence"],
        "properties": {
          "topic": {
            "enum": [
              "purpose_and_writing_stage",
              "research_question",
              "known_and_uncertain_disputes",
              "inclusion_and_exclusion_boundaries",
              "temporal_regional_institutional_and_jurisdictional_scope",
              "source_balance",
              "languages_and_branch_purposes",
              "existing_sources_and_local_materials",
              "citation_tracing_preferences",
              "database_library_and_physical_access",
              "research_scale",
              "interaction_cadence",
              "citation_style_and_outputs",
              "html_preference",
              "project_or_writing_time_claim"
            ]
          },
          "status": {
            "enum": [
              "known",
              "default_accepted",
              "deferred",
              "not_applicable"
            ]
          },
          "value": {},
          "evidence": {
            "type": "object",
            "additionalProperties": false,
            "required": ["origin", "detail"],
            "properties": {
              "origin": {
                "enum": ["user", "existing_context"]
              },
              "detail": {
                "type": "string",
                "minLength": 1
              },
              "captured_at": {
                "type": ["string", "null"]
              }
            }
          }
        }
      }
    },
    "next_round_designable": {
      "type": "boolean"
    },
    "remaining_material_questions": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    }
  }
}
